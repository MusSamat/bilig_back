// bilig_back — PostgreSQL 16 schema (TZ §8). Ids are UUID v7 generated by the
// app (no DB defaults); content additionally has an immutable readable `key`.
// Content is two-layered: relational columns for links/search + a JSONB `doc`
// validated by the shared Zod schemas. Access goes through src/repo/prisma.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & schools
// ---------------------------------------------------------------------------

model User {
  id              String    @id @db.Uuid
  kind            String // adult | student
  email           String?   @unique
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  displayName     String
  locale          String
  status          String // active | blocked | invited | pending
  createdAt       DateTime  @db.Timestamptz(3)
  updatedAt       DateTime  @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)

  credentials Credential[]
  sessions    Session[]
  grants      RoleAssignment[]
  authTokens  AuthToken[]
  enrollments Enrollment[]
  consent     ConsentRecord?

  @@index([deletedAt])
}

model Credential {
  userId      String    @db.Uuid
  type        String // password | pin | google | totp
  secretHash  String
  failedCount Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model Session {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique
  family       String    @db.Uuid
  audience     String // client | admin
  device       String
  ip           String?
  createdAt    DateTime  @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId])
}

model RoleAssignment {
  id        String  @id @db.Uuid
  userId    String  @db.Uuid
  role      String
  scopeType String // platform | school | subject | class
  scopeId   String  @default("") // "" for platform (keeps the unique index total)
  subrole   String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

model AuthToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  purpose   String // email_verify | password_reset
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Invite {
  id         String    @id @db.Uuid
  email      String
  role       String
  scopeType  String
  scopeId    String?
  subrole    String?
  tokenHash  String    @unique
  invitedBy  String    @db.Uuid
  createdAt  DateTime  @db.Timestamptz(3)
  expiresAt  DateTime  @db.Timestamptz(3)
  acceptedAt DateTime? @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)

  @@index([scopeType, scopeId])
}

model School {
  id        String   @id @db.Uuid
  name      String
  region    String
  type      String // state | private
  language  String
  status    String // active | suspended
  createdAt DateTime @db.Timestamptz(3)
  version   Int      @default(1)

  licenses License[]
  classes  Class[]
}

model License {
  id       String   @id @db.Uuid
  schoolId String   @db.Uuid
  subjects String[]
  grades   Int[]
  seats    Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  version  Int      @default(1)
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Class {
  id              String       @id @db.Uuid
  schoolId        String       @db.Uuid
  name            String
  grade           Int
  joinCode        String       @unique
  joinCodeEnabled Boolean
  createdBy       String       @db.Uuid
  createdAt       DateTime     @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]

  @@index([schoolId])
}

model Enrollment {
  classId   String   @db.Uuid
  userId    String   @db.Uuid
  role      String // student | teacher
  createdAt DateTime @db.Timestamptz(3)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

model ConsentRecord {
  studentId   String   @id @db.Uuid
  schoolId    String   @db.Uuid
  confirmedBy String   @db.Uuid
  confirmedAt DateTime @db.Timestamptz(3)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Content dictionary (generic columns + TZ relational columns)
// ---------------------------------------------------------------------------

model SubjectGroup {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  order      Int      @default(0)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid
}

model Subject {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  groupKey   String?
  icon       String?
  hue        Int?
  order      Int      @default(0)
  status     String? // soon | live
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Course {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  grade      Int?
  curriculum String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Unit {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  courseKey  String?
  order      Int      @default(0)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
  @@index([courseKey])
}

model Objective {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  unitKey    String?
  code       String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
  @@index([unitKey])
}

model Concept {
  id          String   @id @db.Uuid
  key         String   @unique
  doc         Json
  subjectKey  String?
  searchText  String   @default("")
  version     Int
  kind        String?
  hue         Int?
  isContainer Boolean  @default(false)
  related     String[]
  createdAt   DateTime @db.Timestamptz(3)
  updatedAt   DateTime @db.Timestamptz(3)
  updatedBy   String?  @db.Uuid

  @@index([subjectKey])
}

model Process {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  engine     String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Item {
  id            String   @id @db.Uuid
  key           String   @unique
  doc           Json
  subjectKey    String?
  searchText    String   @default("")
  version       Int
  type          String?
  difficulty    Int?
  objectiveKeys String[]
  createdAt     DateTime @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  updatedBy     String?  @db.Uuid

  @@index([subjectKey])
}

model GlossaryTerm {
  id         String   @id @db.Uuid
  key        String   @unique // the term id from the content model
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// Topics, versions, builds, assets, strings
// ---------------------------------------------------------------------------

model Topic {
  id                 String    @id @db.Uuid
  key                String    @unique
  unitKey            String
  subjectKey         String
  status             String // draft | review | published | archived
  demo               Boolean   @default(false)
  publishedVersionId String?   @db.Uuid
  latestVersionId    String?   @db.Uuid
  scheduledAt        DateTime? @db.Timestamptz(3)
  scheduledVersionId String?   @db.Uuid
  version            Int
  createdAt          DateTime  @db.Timestamptz(3)
  updatedAt          DateTime  @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  updatedBy          String?   @db.Uuid

  versions TopicVersion[]

  @@index([subjectKey])
  @@index([scheduledAt])
}

model TopicVersion {
  id          String   @id @db.Uuid
  topicId     String   @db.Uuid
  topicKey    String
  version     String
  doc         Json
  authorId    String   @db.Uuid
  createdAt   DateTime @db.Timestamptz(3)
  reviewState String
  message     String?
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  builds      Build[]

  @@unique([topicId, version])
}

model Build {
  id             String       @id @db.Uuid
  topicId        String       @db.Uuid
  topicKey       String
  topicVersionId String       @db.Uuid
  version        String
  status         String // queued | building | ready | failed
  manifest       Json?
  package        Json?
  packageUrl     String?
  hash           String?
  log            String[]
  createdAt      DateTime     @db.Timestamptz(3)
  topicVersion   TopicVersion @relation(fields: [topicVersionId], references: [id], onDelete: Cascade)

  @@index([topicVersionId, status])
  @@index([topicKey])
}

model Asset {
  id           String   @id @db.Uuid
  key          String
  kind         String // glb | image | molfile
  filename     String
  contentType  String
  license      String
  author       String
  source       String
  status       String
  sizeBytes    Int
  sizeAfter    Int?
  triangles    Int?
  nodes        Json
  violations   Json
  originalUrl  String?
  optimizedUrl String?
  thumbUrl     String?
  uploadId     String
  createdBy    String   @db.Uuid
  createdAt    DateTime @db.Timestamptz(3)
  version      Int      @default(1) // current AssetVersion.version

  versions AssetVersion[]
}

/// One uploaded file of an asset (TZ §8 AssetVersion); the Asset row mirrors the current one.
model AssetVersion {
  assetId      String    @db.Uuid
  version      Int
  filename     String
  contentType  String
  status       String
  sizeBytes    Int
  sizeAfter    Int?
  triangles    Int?
  nodes        Json
  violations   Json
  originalUrl  String?
  optimizedUrl String?
  thumbUrl     String?
  uploadId     String
  message      String?
  createdBy    String    @db.Uuid
  createdAt    DateTime  @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, version])
}

model LocaleString {
  key        String
  locale     String
  value      String
  status     String // machine | draft | reviewed
  sourceHash String
  updatedAt  DateTime @db.Timestamptz(3)
  version    Int      @default(1)

  @@id([key, locale])
  @@index([locale, status])
}

model ReviewComment {
  id           String    @id @db.Uuid
  targetType   String
  targetId     String    @db.Uuid
  path         String
  body         String
  authorId     String    @db.Uuid
  createdAt    DateTime  @db.Timestamptz(3)
  resolvedAt   DateTime? @db.Timestamptz(3)
  anchor3d     Json? // [x, y, z]
  resolvedBy   String?   @db.Uuid
  topicVersion String?

  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Learning
// ---------------------------------------------------------------------------

model Progress {
  userId              String   @db.Uuid
  topicKey            String
  visitedConcepts     String[]
  completedActivities String[]
  updatedAt           DateTime @db.Timestamptz(3)

  @@id([userId, topicKey])
}

model Assignment {
  id         String    @id @db.Uuid
  classId    String    @db.Uuid
  topicKey   String
  activities String[]
  dueAt      DateTime? @db.Timestamptz(3)
  createdBy  String    @db.Uuid
  createdAt  DateTime  @db.Timestamptz(3)

  @@index([classId])
}

model Attempt {
  id             String    @id @db.Uuid
  userId         String    @db.Uuid
  clientId       String    @db.Uuid
  assignmentId   String?   @db.Uuid
  topicKey       String
  topicVersion   String
  topicVersionId String    @db.Uuid
  seed           String
  itemKeys       String[]
  startedAt      DateTime  @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  score          Float?
  source         String
  answers        Answer[]

  @@unique([userId, clientId])
  @@index([assignmentId])
  @@index([startedAt])
}

model Answer {
  id         String   @id @db.Uuid
  attemptId  String   @db.Uuid
  itemKey    String
  response   Json
  correct    Boolean
  score      Float
  timeMs     Int
  answeredAt DateTime @db.Timestamptz(3)
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemKey])
  @@index([itemKey])
}

/// xAPI event; `actor` is an HMAC pseudonym. Monthly partitioning is a
/// planned DBA-level migration (Prisma has no partition DSL).
model LearningEvent {
  id         String   @id @db.Uuid
  actor      String
  verb       String
  objectType String
  objectKey  String
  topicKey   String?
  result     Json?
  context    Json?
  ts         DateTime @db.Timestamptz(3)
  receivedAt DateTime @db.Timestamptz(3)

  @@index([ts])
}

model IdempotencyRecord {
  userId      String   @db.Uuid
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @db.Timestamptz(3)

  @@id([userId, key])
}

// ---------------------------------------------------------------------------
// Decks & tutor
// ---------------------------------------------------------------------------

model Presentation {
  id        String   @id @db.Uuid
  ownerId   String   @db.Uuid
  topicKey  String
  title     String
  lang      String
  slides    Json
  version   Int
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  @@index([ownerId])
}

model Snapshot {
  id           String   @id @db.Uuid
  ownerId      String   @db.Uuid
  topicKey     String
  topicVersion String
  imageKey     String
  imageUrl     String
  sceneState   Json
  createdAt    DateTime @db.Timestamptz(3)

  @@index([ownerId])
}

model TutorThread {
  id        String         @id @db.Uuid
  userId    String?        @db.Uuid
  topicKey  String
  createdAt DateTime       @db.Timestamptz(3)
  messages  TutorMessage[]
}

model TutorMessage {
  id           String      @id @db.Uuid
  threadId     String      @db.Uuid
  role         String
  text         String
  citations    String[]
  inputTokens  Int
  outputTokens Int
  flagged      Boolean
  topicKey     String
  schoolId     String?     @db.Uuid
  createdAt    DateTime    @db.Timestamptz(3)
  thread       TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
}

// ---------------------------------------------------------------------------
// Audit & settings
// ---------------------------------------------------------------------------

/// Append-only (the repository exposes no update/delete).
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  diff       Json?
  ip         String?
  ts         DateTime @db.Timestamptz(3)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
}

model Setting {
  key       String   @id
  value     Json
  version   Int
  updatedAt DateTime @db.Timestamptz(3)
}
