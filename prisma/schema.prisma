// bilig_back — PostgreSQL 16 schema (TZ §8). Ids are UUID v7 generated by the
// app (no DB defaults); content additionally has an immutable readable `key`.
// Content is two-layered: relational columns for links/search + a JSONB `doc`
// validated by the shared Zod schemas. Access goes through src/repo/prisma.ts.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Identity & schools
// ---------------------------------------------------------------------------

model User {
  id              String    @id @db.Uuid
  kind            String // adult | student
  email           String?   @unique
  emailVerifiedAt DateTime? @db.Timestamptz(3)
  displayName     String
  locale          String
  status          String // active | blocked | invited | pending
  createdAt       DateTime  @db.Timestamptz(3)
  updatedAt       DateTime  @db.Timestamptz(3)
  deletedAt       DateTime? @db.Timestamptz(3)
  /// v0.6.0: pending self-registration details { teaching?, schoolName?, region? } until the e-mail is confirmed.
  signup          Json?
  /// v0.7.0: the teacher's WhatsApp number (E.164 `+996XXXXXXXXX`), verified with a one-time code.
  phone           String?   @unique
  phoneVerifiedAt DateTime? @db.Timestamptz(3)
  /// v0.8.0: the language the teacher teaches in (ky | ru | uz | en).
  teachingLang    String?
  /// v0.8.0: the last successful sign-in (any audience).
  lastLoginAt     DateTime? @db.Timestamptz(3)

  credentials Credential[]
  sessions    Session[]
  grants      RoleAssignment[]
  authTokens  AuthToken[]
  enrollments Enrollment[]
  consent     ConsentRecord?

  @@index([deletedAt])
}

model Credential {
  userId      String    @db.Uuid
  type        String // password | pin | google | totp
  secretHash  String
  failedCount Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  updatedAt   DateTime  @db.Timestamptz(3)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, type])
}

model Session {
  id           String    @id @db.Uuid
  userId       String    @db.Uuid
  refreshHash  String    @unique
  family       String    @db.Uuid
  audience     String // client | admin
  device       String
  ip           String?
  createdAt    DateTime  @db.Timestamptz(3)
  expiresAt    DateTime  @db.Timestamptz(3)
  revokedAt    DateTime? @db.Timestamptz(3)
  replacedById String?   @db.Uuid
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([family])
  @@index([userId])
}

model RoleAssignment {
  id        String  @id @db.Uuid
  userId    String  @db.Uuid
  role      String
  scopeType String // platform | school | subject | class
  scopeId   String  @default("") // "" for platform (keeps the unique index total)
  subrole   String?
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, role, scopeType, scopeId])
  @@index([scopeType, scopeId])
}

model AuthToken {
  id        String    @id @db.Uuid
  userId    String    @db.Uuid
  purpose   String // email_verify | password_reset | totp_enroll | email_code
  tokenHash String    @unique
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)
  /// v0.6.0: wrong tries against an e-mail code (burned at 5).
  attempts  Int       @default(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, purpose])
}

/// v0.7.0: phone-keyed one-time codes (sent to WhatsApp) and the short-lived
/// tokens they are exchanged for. Not tied to a user: a registration has none yet.
model PhoneOtp {
  id        String    @id @db.Uuid
  phone     String
  purpose   String // register | reset
  kind      String // code | token
  /// code: sha256 bound to the row id; token: sha256 of the opaque token.
  hash      String    @unique
  locale    String
  attempts  Int       @default(0)
  createdAt DateTime  @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  usedAt    DateTime? @db.Timestamptz(3)

  @@index([phone, purpose, kind])
}

model Invite {
  id          String    @id @db.Uuid
  email       String
  role        String
  scopeType   String
  scopeId     String?
  subrole     String?
  /// v0.8.0: the permissions ticked for a manager invite.
  permissions String[]  @default([])
  tokenHash   String    @unique
  invitedBy   String    @db.Uuid
  createdAt   DateTime  @db.Timestamptz(3)
  expiresAt   DateTime  @db.Timestamptz(3)
  acceptedAt  DateTime? @db.Timestamptz(3)
  revokedAt   DateTime? @db.Timestamptz(3)

  @@index([scopeType, scopeId])
}

model School {
  id        String   @id @db.Uuid
  name      String
  region    String
  type      String // state | private
  language  String
  status    String // active | suspended
  /// v0.6.0: admin (created by staff) | self (a self-registered teacher's personal school)
  origin    String   @default("admin")
  createdAt DateTime @db.Timestamptz(3)
  version   Int      @default(1)

  licenses License[]
  classes  Class[]
}

model License {
  id       String   @id @db.Uuid
  schoolId String   @db.Uuid
  subjects String[]
  grades   Int[]
  seats    Int
  startsAt DateTime @db.Timestamptz(3)
  endsAt   DateTime @db.Timestamptz(3)
  version  Int      @default(1)
  school   School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@index([schoolId])
}

model Class {
  id              String       @id @db.Uuid
  schoolId        String       @db.Uuid
  name            String
  grade           Int
  joinCode        String       @unique
  joinCodeEnabled Boolean
  /// v0.6.0: subject the teacher teaches in this class (one of the school's licensed subjects).
  subjectKey      String?
  /// v0.8.0: every subject taught in the class (subjectKey = subjectKeys[0]).
  subjectKeys     String[]     @default([])
  createdBy       String       @db.Uuid
  createdAt       DateTime     @db.Timestamptz(3)
  deletedAt       DateTime?    @db.Timestamptz(3)
  school          School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments     Enrollment[]

  @@index([schoolId])
}

model Enrollment {
  classId   String   @db.Uuid
  userId    String   @db.Uuid
  role      String // student | teacher
  createdAt DateTime @db.Timestamptz(3)
  class     Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([classId, userId])
  @@index([userId])
}

model ConsentRecord {
  studentId   String   @id @db.Uuid
  schoolId    String   @db.Uuid
  confirmedBy String   @db.Uuid
  confirmedAt DateTime @db.Timestamptz(3)
  student     User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
}

// ---------------------------------------------------------------------------
// Content dictionary (generic columns + TZ relational columns)
// ---------------------------------------------------------------------------

model SubjectGroup {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  order      Int      @default(0)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid
}

model Subject {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  groupKey   String?
  icon       String?
  hue        Int?
  order      Int      @default(0)
  status     String? // soon | live
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Course {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  grade      Int?
  curriculum String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Unit {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  courseKey  String?
  order      Int      @default(0)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
  @@index([courseKey])
}

/// v0.5.0: textbooks mapped onto topics (shared across subjects).
model Textbook {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  grade      Int?
  order      Int      @default(0)
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
  @@index([grade])
}

model Objective {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  unitKey    String?
  code       String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
  @@index([unitKey])
}

model Concept {
  id          String   @id @db.Uuid
  key         String   @unique
  doc         Json
  subjectKey  String?
  searchText  String   @default("")
  version     Int
  kind        String?
  hue         Int?
  isContainer Boolean  @default(false)
  related     String[]
  createdAt   DateTime @db.Timestamptz(3)
  updatedAt   DateTime @db.Timestamptz(3)
  updatedBy   String?  @db.Uuid

  @@index([subjectKey])
}

model Process {
  id         String   @id @db.Uuid
  key        String   @unique
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  engine     String?
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid

  @@index([subjectKey])
}

model Item {
  id            String   @id @db.Uuid
  key           String   @unique
  doc           Json
  subjectKey    String?
  searchText    String   @default("")
  version       Int
  type          String?
  difficulty    Int?
  objectiveKeys String[]
  createdAt     DateTime @db.Timestamptz(3)
  updatedAt     DateTime @db.Timestamptz(3)
  updatedBy     String?  @db.Uuid

  @@index([subjectKey])
}

model GlossaryTerm {
  id         String   @id @db.Uuid
  key        String   @unique // the term id from the content model
  doc        Json
  subjectKey String?
  searchText String   @default("")
  version    Int
  createdAt  DateTime @db.Timestamptz(3)
  updatedAt  DateTime @db.Timestamptz(3)
  updatedBy  String?  @db.Uuid
}

// ---------------------------------------------------------------------------
// Topics, versions, builds, assets, strings
// ---------------------------------------------------------------------------

model Topic {
  id                 String    @id @db.Uuid
  key                String    @unique
  unitKey            String
  subjectKey         String
  status             String // draft | review | published | archived
  demo               Boolean   @default(false)
  publishedVersionId String?   @db.Uuid
  latestVersionId    String?   @db.Uuid
  scheduledAt        DateTime? @db.Timestamptz(3)
  scheduledVersionId String?   @db.Uuid
  version            Int
  createdAt          DateTime  @db.Timestamptz(3)
  updatedAt          DateTime  @db.Timestamptz(3)
  deletedAt          DateTime? @db.Timestamptz(3)
  updatedBy          String?   @db.Uuid

  versions TopicVersion[]

  @@index([subjectKey])
  @@index([scheduledAt])
}

model TopicVersion {
  id          String   @id @db.Uuid
  topicId     String   @db.Uuid
  topicKey    String
  version     String
  doc         Json
  authorId    String   @db.Uuid
  createdAt   DateTime @db.Timestamptz(3)
  reviewState String
  message     String?
  topic       Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  builds      Build[]

  @@unique([topicId, version])
}

model Build {
  id             String       @id @db.Uuid
  topicId        String       @db.Uuid
  topicKey       String
  topicVersionId String       @db.Uuid
  version        String
  status         String // queued | building | ready | failed
  manifest       Json?
  package        Json?
  packageUrl     String?
  hash           String?
  log            String[]
  createdAt      DateTime     @db.Timestamptz(3)
  topicVersion   TopicVersion @relation(fields: [topicVersionId], references: [id], onDelete: Cascade)

  @@index([topicVersionId, status])
  @@index([topicKey])
}

model Asset {
  id           String   @id @db.Uuid
  key          String
  kind         String // glb | image | molfile
  filename     String
  contentType  String
  license      String
  author       String
  source       String
  status       String
  sizeBytes    Int
  sizeAfter    Int?
  triangles    Int?
  nodes        Json
  violations   Json
  originalUrl  String?
  optimizedUrl String?
  thumbUrl     String?
  uploadId     String
  createdBy    String   @db.Uuid
  createdAt    DateTime @db.Timestamptz(3)
  version      Int      @default(1) // current AssetVersion.version

  versions AssetVersion[]
}

/// One uploaded file of an asset (TZ §8 AssetVersion); the Asset row mirrors the current one.
model AssetVersion {
  assetId      String    @db.Uuid
  version      Int
  filename     String
  contentType  String
  status       String
  sizeBytes    Int
  sizeAfter    Int?
  triangles    Int?
  nodes        Json
  violations   Json
  originalUrl  String?
  optimizedUrl String?
  thumbUrl     String?
  uploadId     String
  message      String?
  createdBy    String    @db.Uuid
  createdAt    DateTime  @db.Timestamptz(3)
  completedAt  DateTime? @db.Timestamptz(3)
  asset        Asset     @relation(fields: [assetId], references: [id], onDelete: Cascade)

  @@id([assetId, version])
}

model LocaleString {
  key        String
  locale     String
  value      String
  status     String // machine | draft | reviewed
  sourceHash String
  updatedAt  DateTime @db.Timestamptz(3)
  version    Int      @default(1)

  @@id([key, locale])
  @@index([locale, status])
}

model ReviewComment {
  id           String    @id @db.Uuid
  targetType   String
  targetId     String    @db.Uuid
  path         String
  body         String
  authorId     String    @db.Uuid
  createdAt    DateTime  @db.Timestamptz(3)
  resolvedAt   DateTime? @db.Timestamptz(3)
  anchor3d     Json? // [x, y, z]
  resolvedBy   String?   @db.Uuid
  topicVersion String?

  @@index([targetType, targetId])
}

// ---------------------------------------------------------------------------
// Learning
// ---------------------------------------------------------------------------

model Progress {
  userId              String   @db.Uuid
  topicKey            String
  visitedConcepts     String[]
  completedActivities String[]
  updatedAt           DateTime @db.Timestamptz(3)

  @@id([userId, topicKey])
}

model Assignment {
  id         String    @id @db.Uuid
  classId    String    @db.Uuid
  topicKey   String
  activities String[]
  dueAt      DateTime? @db.Timestamptz(3)
  createdBy  String    @db.Uuid
  createdAt  DateTime  @db.Timestamptz(3)

  @@index([classId])
}

model Attempt {
  id             String    @id @db.Uuid
  userId         String    @db.Uuid
  clientId       String    @db.Uuid
  assignmentId   String?   @db.Uuid
  topicKey       String
  topicVersion   String
  topicVersionId String    @db.Uuid
  seed           String
  itemKeys       String[]
  startedAt      DateTime  @db.Timestamptz(3)
  finishedAt     DateTime? @db.Timestamptz(3)
  score          Float?
  source         String
  answers        Answer[]

  @@unique([userId, clientId])
  @@index([assignmentId])
  @@index([startedAt])
}

model Answer {
  id         String   @id @db.Uuid
  attemptId  String   @db.Uuid
  itemKey    String
  response   Json
  correct    Boolean
  score      Float
  timeMs     Int
  answeredAt DateTime @db.Timestamptz(3)
  attempt    Attempt  @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, itemKey])
  @@index([itemKey])
}

/// xAPI event; `actor` is an HMAC pseudonym. Monthly partitioning is a
/// planned DBA-level migration (Prisma has no partition DSL).
model LearningEvent {
  id         String   @id @db.Uuid
  actor      String
  verb       String
  objectType String
  objectKey  String
  topicKey   String?
  result     Json?
  context    Json?
  ts         DateTime @db.Timestamptz(3)
  receivedAt DateTime @db.Timestamptz(3)

  @@index([ts])
}

model IdempotencyRecord {
  userId      String   @db.Uuid
  key         String
  requestHash String
  response    Json
  createdAt   DateTime @db.Timestamptz(3)

  @@id([userId, key])
}

// ---------------------------------------------------------------------------
// Decks & tutor
// ---------------------------------------------------------------------------

model Presentation {
  id        String   @id @db.Uuid
  ownerId   String   @db.Uuid
  topicKey  String
  title     String
  lang      String
  slides    Json
  version   Int
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  @@index([ownerId])
}

/// v0.5.0: an uploaded КТП (календарно-тематический план); `doc` = TeachingPlan DTO body
model TeachingPlan {
  id        String   @id @db.Uuid
  ownerId   String   @db.Uuid
  title     String
  doc       Json
  version   Int
  createdAt DateTime @db.Timestamptz(3)
  updatedAt DateTime @db.Timestamptz(3)

  @@index([ownerId])
}

model Snapshot {
  id           String   @id @db.Uuid
  ownerId      String   @db.Uuid
  topicKey     String
  topicVersion String
  imageKey     String
  imageUrl     String
  sceneState   Json
  createdAt    DateTime @db.Timestamptz(3)

  @@index([ownerId])
}

model TutorThread {
  id        String         @id @db.Uuid
  userId    String?        @db.Uuid
  topicKey  String
  createdAt DateTime       @db.Timestamptz(3)
  messages  TutorMessage[]
}

model TutorMessage {
  id           String      @id @db.Uuid
  threadId     String      @db.Uuid
  role         String
  text         String
  citations    String[]
  inputTokens  Int
  outputTokens Int
  flagged      Boolean
  topicKey     String
  schoolId     String?     @db.Uuid
  createdAt    DateTime    @db.Timestamptz(3)
  thread       TutorThread @relation(fields: [threadId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([createdAt])
}

/// v0.4.0: pool of AI-generated examples / practice questions (POST /tutor/generate) and their review state.
model GeneratedContent {
  id         String    @id @db.Uuid
  kind       String
  topicKey   String
  conceptKey String?
  lang       String
  payload    Json
  signature  String
  status     String    @default("new")
  good       Int       @default(0)
  bad        Int       @default(0)
  reasons    Json      @default("{}")
  served     Int       @default(0)
  createdAt  DateTime  @db.Timestamptz(3)
  reviewedAt DateTime? @db.Timestamptz(3)
  reviewedBy String?   @db.Uuid
  promotedTo String?

  @@index([topicKey, kind, lang])
  @@index([status])
}

// ---------------------------------------------------------------------------
// Audit & settings
// ---------------------------------------------------------------------------

/// Legacy audit log: read only since v0.8.0 (rows copied into AuditEvent; a trigger rejects writes).
model AuditLog {
  id         String   @id @db.Uuid
  actorId    String?  @db.Uuid
  action     String
  targetType String
  targetId   String
  diff       Json?
  ip         String?
  ts         DateTime @db.Timestamptz(3)

  @@index([actorId])
  @@index([action])
  @@index([targetType])
}

model Setting {
  key       String   @id
  value     Json
  version   Int
  updatedAt DateTime @db.Timestamptz(3)
}

// ---------------------------------------------------------------------------
// v0.8.0: staff, support sessions, the action journal, deletion requests
// ---------------------------------------------------------------------------

/// A staff member (manager or SuperAdmin): the permissions SuperAdmin ticked
/// for a manager (the matrix stays the ceiling) and the lifecycle.
model StaffProfile {
  userId      String    @id @db.Uuid
  permissions String[]  @default([])
  /// Reserved for a future narrower scope (null = the whole platform).
  scope       Json?
  createdBy   String?   @db.Uuid
  createdAt   DateTime  @db.Timestamptz(3)
  blockedAt   DateTime? @db.Timestamptz(3)
  deletedAt   DateTime? @db.Timestamptz(3)
}

/// A staff member working in a teacher's cabinet (support): 15 min view / 30 min edit, no refresh.
model ImpersonationSession {
  id        String    @id @db.Uuid
  actorId   String    @db.Uuid
  teacherId String    @db.Uuid
  mode      String // view | edit
  reason    String?
  ip        String?
  startedAt DateTime  @db.Timestamptz(3)
  expiresAt DateTime  @db.Timestamptz(3)
  endedAt   DateTime? @db.Timestamptz(3)
  endedBy   String?   @db.Uuid
  endReason String? // ended | expired

  @@index([actorId])
  @@index([teacherId])
  @@index([endedAt, expiresAt])
}

/// The append-only, hash-chained action journal. Partitioned by month on `at`
/// (raw SQL in the 0.8.0 migration): inserts go through audit_event_append(),
/// a trigger rejects UPDATE and DELETE, old partitions are dropped (retention).
model AuditEvent {
  seq              BigInt
  id               String   @db.Uuid
  at               DateTime @db.Timestamptz(3)
  actorId          String?  @db.Uuid
  actorRole        String?
  onBehalfOfId     String?  @db.Uuid
  group            String
  action           String
  targetType       String
  targetId         String
  targetLabel      String?
  before           Json?
  after            Json?
  /// The legacy free-form `diff` (also everything copied from AuditLog).
  details          Json?
  reason           String?
  result           String // ok | denied | failed
  ip               String?
  userAgent        String?
  requestId        String?
  supportSessionId String?  @db.Uuid
  prevHash         String
  hash             String

  @@id([seq, at])
  @@index([id])
  @@index([actorId, seq])
  @@index([onBehalfOfId])
  @@index([action])
  @@index([targetType, targetId])
}

/// Journal alerts for SuperAdmin; `key` de-duplicates (one alert per incident).
model AuditAlert {
  id      String    @id @db.Uuid
  key     String    @unique
  at      DateTime  @db.Timestamptz(3)
  kind    String // mass_deletion | chain_broken | support_edit
  actorId String?   @db.Uuid
  summary String
  seenAt  DateTime? @db.Timestamptz(3)

  @@index([at])
}

/// A manager asks to delete a teacher or content; SuperAdmin approves (TOTP) or rejects.
model DeletionRequest {
  id           String    @id @db.Uuid
  kind         String // teacher | topic | concept | item | asset
  targetId     String
  targetLabel  String
  reason       String
  status       String // pending | approved | rejected
  requestedBy  String    @db.Uuid
  requestedAt  DateTime  @db.Timestamptz(3)
  decidedBy    String?   @db.Uuid
  decidedAt    DateTime? @db.Timestamptz(3)
  decisionNote String?

  @@index([status])
  @@index([requestedBy])
}
