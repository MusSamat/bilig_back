{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "declaration": false,
    "paths": {
      "@bilig/permissions": ["./packages/permissions/src/index.ts"],
      "@bilig/content-model": ["./packages/content-model/src/index.ts"],
      "@bilig/content-model/api": ["./packages/content-model/src/api/index.ts"],
      "@bilig/content-model/fixtures/*": ["./packages/content-model/src/fixtures/*.ts"]
    },
    "baseUrl": "."
  }
}
