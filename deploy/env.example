# Production settings for deploy/docker-compose.yml. deploy.sh copies this to
# deploy/production.env (git-ignored) with fresh secrets on the first run.

# Public address of the site, no trailing slash. Without a domain use the
# free sslip.io name of the server's IP (HTTPS works with Let's Encrypt):
#   https://bilig.203-0-113-5.sslip.io
BILIG_URL=https://bilig.203-0-113-5.sslip.io

# Loopback port the site listens on; the server's TLS proxy forwards to it.
BILIG_HTTP_PORT=8081

# Secrets (deploy.sh fills these with `openssl rand -hex 32`).
POSTGRES_PASSWORD=
JWT_SECRET=
PSEUDONYM_SECRET=

# Assistant: `anthropic` with a key, or `none` (assistant off). `dev` is refused in production.
TUTOR_PROVIDER=none
ANTHROPIC_API_KEY=

# First superadmin, created on start-up if missing (then enrol TOTP in the app).
# Clear both after the first login.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Only for a test run over plain http://IP:port (no TLS): cookies must not be Secure.
# COOKIE_SECURE=false

# Teacher self-registration (contract 0.6.0 e-mail, 0.7.0 phone / WhatsApp).
# TEMPORARY until a WhatsApp provider and a mail server are configured.
# Every one-time code (e-mail confirmation and WhatsApp phone codes) is this
# value and phone codes are not sent at all (the server logs a warning at start).
AUTH_FIXED_OTP=012345
# TEMPORARY, test period only: the admin panel (/admin) accepts this fixed
# 2FA code for every admin, also without an authenticator app. Anyone with
# an admin's e-mail and password gets in. Every such sign-in is marked
# totp=fixed in the audit log; the server logs a warning at start.
# Uncomment for testing; delete before real use to restore normal 2FA.
# AUTH_FIXED_TOTP=012345
# How phone codes reach WhatsApp: fixed (needs AUTH_FIXED_OTP) | console
# (prints them; refused in production) | whatsapp (provider not implemented
# yet; refused at start). Unset: fixed with AUTH_FIXED_OTP, else the server
# refuses to start in production ("No working sender for phone one-time codes").
# OTP_SENDER=fixed
# Length of a self-registered teacher's trial licence, days (1–365).
TRIAL_DAYS=30

LOG_LEVEL=info
