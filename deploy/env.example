# Production settings for deploy/docker-compose.yml. deploy.sh copies this to
# deploy/production.env (git-ignored) with fresh secrets on the first run.

# Public address of the site, no trailing slash. Without a domain use the
# free sslip.io name of the server's IP (HTTPS works with Let's Encrypt):
#   https://bilig.203-0-113-5.sslip.io
BILIG_URL=https://bilig.203-0-113-5.sslip.io

# Loopback port the site listens on; the server's TLS proxy forwards to it.
BILIG_HTTP_PORT=8081

# Secrets (deploy.sh fills these with `openssl rand -hex 32`).
POSTGRES_PASSWORD=
JWT_SECRET=
PSEUDONYM_SECRET=

# Assistant: `anthropic` with a key, or `none` (assistant off). `dev` is refused in production.
TUTOR_PROVIDER=none
ANTHROPIC_API_KEY=

# First superadmin, created on start-up if missing (then enrol TOTP in the app).
# Clear both after the first login.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=

# Only for a test run over plain http://IP:port (no TLS): cookies must not be Secure.
# COOKIE_SECURE=false

LOG_LEVEL=info
