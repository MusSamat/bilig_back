{
  "name": "bilig_back",
  "private": true,
  "version": "0.1.0",
  "description": "Bilig API — catalog, content packages, AI tutor, RBAC (Fastify + TS).",
  "type": "module",
  "main": "src/main.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contract:hash": "node scripts/contract-hash.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.68.0",
    "@bilig/content-model": "*",
    "@bilig/permissions": "*",
    "@fastify/cors": "^10.0.1",
    "fastify": "^5.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.3.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
