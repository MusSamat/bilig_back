{
  "name": "bilig_back",
  "private": true,
  "version": "0.1.0",
  "description": "Bilig API — catalog, content packages, AI tutor, RBAC (Fastify + TS).",
  "type": "module",
  "main": "src/main.ts",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "start": "tsx src/main.ts",
    "start:dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit && npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "contract:hash": "node scripts/contract-hash.mjs",
    "postinstall": "prisma generate",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "tsx scripts/db-seed.ts",
    "db:seed:demo": "tsx scripts/db-seed-demo.ts",
    "test:db": "node scripts/test-db.mjs",
    "tutor:eval": "tsx scripts/tutor-eval.ts",
    "books:import": "tsx scripts/books-import.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@bilig/content-model": "*",
    "@bilig/permissions": "*",
    "@fastify/cookie": "^11.1.3",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "^6.19.3",
    "docxtemplater": "3.71.0",
    "fastify": "^5.1.0",
    "fontkit": "2.0.4",
    "ioredis": "^5.11.1",
    "jose": "^6.2.12",
    "openai": "7.28.0",
    "pdfkit": "^0.17.2",
    "pizzip": "3.3.0",
    "pptxgenjs": "^4.0.1",
    "sharp": "0.34.3",
    "uuid": "^11.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pdfkit": "^0.17.6",
    "@vitest/coverage-v8": "^2.1.9",
    "prettier": "^3.3.3",
    "prisma": "^6.19.3",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=20"
  }
}
