# bilig_back configuration
PORT=3000
HOST=0.0.0.0

# AI tutor (TZ W-32: online assistant). When unset, /api/tutor returns 503 and
# the client falls back to its offline MiniSearch index over the topic package.
ANTHROPIC_API_KEY=

# Comma-separated allowed origins for CORS (the bilig_ft dev server by default).
CORS_ORIGIN=http://localhost:5173
