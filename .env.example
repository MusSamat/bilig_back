# bilig_back configuration — copy to .env (never commit .env).
NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Storage: `prisma` (PostgreSQL, default) or `memory` (no persistence; content/** loaded on boot).
STORAGE=prisma
# docker compose: postgres:16 on host port 55433 (see docker-compose.yml)
DATABASE_URL=postgresql://bilig:bilig@localhost:55433/bilig
# Separate database used by `npm run test:db` (created by the compose init script)
TEST_DATABASE_URL=postgresql://bilig:bilig@localhost:55433/bilig_test
# Redis 7 for rate limits / tutor budget (host port 56379). Unset or unreachable → in-memory fallback.
REDIS_URL=redis://localhost:56379

# Secrets — REQUIRED in production (dev generates random ones per process).
# openssl rand -hex 32
JWT_SECRET=
PSEUDONYM_SECRET=
# Refresh cookie `Secure` flag (keep true; browsers accept Secure cookies on http://localhost)
COOKIE_SECURE=true

# Comma-separated allowed origins for CORS (bilig_ft dev server, admin).
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
PUBLIC_URL=http://localhost:3000
APP_URL=http://localhost:5173
ADMIN_URL=http://localhost:5174
# Optional CDN for packages: ${CDN_BASE_URL}/<hash>/package.json
CDN_BASE_URL=
TRUST_PROXY=false

# Local object storage for snapshots and exports (S3/MinIO adapter later).
STORAGE_DIR=./var/storage
# Content source for `npm run db:seed` / memory mode (default ./content)
CONTENT_DIR=

# AI tutor (W-32). Unset → POST /api/v1/tutor/ask answers 503 and the client shows "unavailable".
ANTHROPIC_API_KEY=
TUTOR_MODEL=claude-opus-5-5
TUTOR_DAILY_TOKEN_BUDGET=2000000

# Mail: `console` prints verification/reset/invite links to stdout (dev).
MAIL_TRANSPORT=console

# Optional dev superadmin created by `npm run db:seed`
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
