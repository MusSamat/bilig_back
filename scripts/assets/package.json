{
  "name": "@bilig/asset-scripts",
  "private": true,
  "type": "module",
  "description": "Offline asset pipeline for content/assets (gltf-transform). Not part of the server build; install with `npm install` in this folder.",
  "scripts": {
    "heart": "node human-heart.mjs",
    "earth": "node earth-layers.mjs",
    "animal-cell": "node cells.mjs animal ../../content/assets/animal-cell/models/animal-cell.glb",
    "plant-cell": "node cells.mjs plant ../../content/assets/plant-cell/models/plant-cell.glb",
    "leaf": "node leaf.mjs ../../content/assets/photosynthesis/models/leaf.glb",
    "skeleton": "node skeleton.mjs ../../content/assets/skeleton-muscles/skeleton.glb",
    "respiratory": "node respiratory.mjs ../../content/assets/respiratory-system/respiratory.glb",
    "inspect": "node inspect.mjs"
  },
  "dependencies": {
    "@gltf-transform/core": "4.2.1",
    "@gltf-transform/extensions": "4.2.1",
    "@gltf-transform/functions": "4.2.1",
    "meshoptimizer": "0.22.0",
    "sharp": "0.34.3",
    "three": "0.169.0"
  }
}
